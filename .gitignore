# ============================================================
# .gitignore for a Python quant research project on macOS
# ============================================================

# ---- macOS system files ----
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Jupyter ----
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---- IDEs and editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject

# ---- Testing, linting, type-checking caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- Secrets and credentials (CRITICAL — never commit) ----
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
credentials.json
config.local.*

# ---- Quant project data ----
# Raw and processed data are large and re-derivable; re-run data_loader.py
# to regenerate. Only small summary outputs in results/ should be tracked.
data/raw/
data/processed/
data/cache/

# ---- Large binary data formats (ignore wherever they appear) ----
*.parquet
*.h5
*.hdf5
*.feather
*.pkl
*.pickle

# ---- Logs and runtime caches ----
*.log
logs/
.cache/
